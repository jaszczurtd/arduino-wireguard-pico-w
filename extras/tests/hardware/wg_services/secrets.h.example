// Copy to secrets.h next to wg_services.ino and fill in. Git ignores secrets.h.
#pragma once

#define WIFI_SSID "network-name"
#define WIFI_PASS "network-password"

// This board's private key and the host's public key (base64).
#define WG_PRIV "board-private-key"
#define WG_PEER_PUB "host-public-key"

// The host's LAN address (WireGuard endpoint and the "LAN outside the tunnel" check)
// and the UDP port its WireGuard interface listens on.
#define WG_ENDPOINT "192.168.1.10"
#define HOST_LAN_IP "192.168.1.10"
#define WG_PORT 51821

// Optional: a DNS name that resolves to the host, for the endpoint-by-name check.
// #define WG_ENDPOINT_NAME "192-168-1-10.sslip.io"
